# --- Homebrew -----------------------------------------------
# .zprofile already did this for login shells; the fallback
# covers the non-login case. It has to come before `path=()` and
# before compinit, since shellenv also runs path_helper and adds
# brew's completions to fpath.

[[ -n $HOMEBREW_PREFIX ]] || eval "$(/opt/homebrew/bin/brew shellenv zsh)"

export EDITOR=nvim VISUAL=nvim


# --- Android / Tauri toolchain ------------------------------
# Homebrew's openjdk@17 is keg-only and not on PATH, so JAVA_HOME
# must point at the real JDK home under libexec. The SDK sits in
# ~/android-sdk rather than the Android Studio default, and the
# NDK is pinned so builds stay reproducible.

export JAVA_HOME="/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
export ANDROID_HOME="$HOME/android-sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export NDK_HOME="$ANDROID_HOME/ndk/26.1.10909125"
export ANDROID_NDK_HOME="$NDK_HOME"


# --- PATH ---------------------------------------------------
# One assignment, highest precedence first, in front of the
# Homebrew entries shellenv already put in place.

typeset -U path

path=(
  $HOME/.local/share/bob/nvim-bin   # bob-managed Neovim
  $HOME/.cargo/bin                  # cargo-installed binaries
  /opt/homebrew/opt/rustup/bin      # rustup toolchain shims
  $HOME/.local/bin                  # personal scripts, uv tools
  $JAVA_HOME/bin                    # java, javac (keg-only)
  $ANDROID_HOME/platform-tools      # adb, fastboot
  $path
)


# --- History ------------------------------------------------
# Persist 50k commands, shared across sessions, deduped, and
# skipping anything typed with a leading space.

HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE \
       HIST_REDUCE_BLANKS EXTENDED_HISTORY


# --- Shell behavior -----------------------------------------
# Bare directory name cds into it, with a directory stack.

setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS INTERACTIVE_COMMENTS NO_BEEP


# --- Completion ---------------------------------------------
# Selectable menu, case-insensitive matching, grouped sections.
# compinit's security check walks every directory in fpath and is
# the slow part of startup, so it runs once a day and the cached
# dump is trusted in between.

autoload -Uz compinit

_zdump=${ZDOTDIR:-$HOME}/.zcompdump
if [[ -f $_zdump && -z $_zdump(#qN.mh+24) ]]; then
  compinit -C -d $_zdump
else
  compinit -d $_zdump
fi
unset _zdump

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'


# --- Aliases ------------------------------------------------
# The eza ones chain off `ls`, so its flags are set in one place.
# `cat` is deliberately left as real cat -- use `c`.

alias ls='eza --icons --group-directories-first'
alias ll='ls -l --git'
alias la='ls -la --git'
alias lt='ls --tree --level=2'
alias lta='lt -a'

alias c='bat --paging=never --style=plain'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias g='git'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate'

alias vi='nvim'


# --- Tool integrations --------------------------------------
# Starship prompt, zoxide smart cd, fzf. Syntax highlighting has
# to be sourced last -- it wraps widgets and needs to see the
# final set.

export _ZO_DOCTOR=0

eval "$(starship init zsh)"
eval "$(zoxide init --cmd cd zsh)"
source <(fzf --zsh)
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh


# --- Secrets ------------------------------------------------
# API keys, never committed. Created by bootstrap.sh, mode 600.

[[ -r ${ZDOTDIR:-$HOME}/secrets.zsh ]] && source ${ZDOTDIR:-$HOME}/secrets.zsh


# --- Greeting -----------------------------------------------

[[ $TERM != dumb ]] && fastfetch
